#include <stdio.h>
#include <stdlib.h>
#include <limits.h>
void kruskalMST(int **cost, int V)
{
    int parent[V];

    // Initially, every vertex is its own parent
    for (int i = 0; i < V; i++)
        parent[i] = i;

    int edges = 0;
    int minCost = 0;

    while (edges < V - 1)
    {
        int min = 9999;
        int u = -1;
        int v = -1;

        // Find the minimum weight edge
        // Row-wise order in upper triangular matrix
        for (int i = 0; i < V; i++)
        {
            for (int j = i + 1; j < V; j++)
            {
                if (cost[i][j] < min)
                {
                    min = cost[i][j];
                    u = i;
                    v = j;
                }
            }
        }

        // Find roots of u and v
        int a = u;
        while (parent[a] != a)
            a = parent[a];

        int b = v;
        while (parent[b] != b)
            b = parent[b];

        // If roots are different, include this edge
        if (a != b)
        {
            printf("Edge %d:(%d, %d) cost:%d\n",
                   edges, u, v, min);

            minCost += min;
            edges++;

            parent[b] = a;
        }

        // Remove this edge from consideration
        cost[u][v] = 9999;
        cost[v][u] = 9999;
    }

    printf("Minimum cost= %d\n", minCost);
}




int main() {
    int V;
    printf("No of vertices: ");
    scanf("%d", &V);

    int **cost = (int **)malloc(V * sizeof(int *));
    for (int i = 0; i < V; i++)
        cost[i] = (int *)malloc(V * sizeof(int));

    printf("Adjacency matrix:\n");
    for (int i = 0; i < V; i++)
        for (int j = 0; j < V; j++)
            scanf("%d", &cost[i][j]);

    kruskalMST(cost, V);

    for (int i = 0; i < V; i++)
        free(cost[i]);
    free(cost);

    return 0;
}
