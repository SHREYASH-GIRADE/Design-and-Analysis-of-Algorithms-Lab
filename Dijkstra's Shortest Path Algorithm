#include <limits.h> 
#include <stdio.h>
#define MAX 20
int V, E;
int graph[MAX][MAX];
#define INFINITY 99999

void dijkstra(int G[MAX][MAX], int n, int startnode) {
	

    int distance[MAX], pred[MAX];
    int visited[MAX];
    int count, mindistance, nextnode, i, j;

    // Step 1: Initialize distances, predecessors, and visited tracking
    for (i = 1; i <= n; i++) {
        visited[i] = 0;
        pred[i] = startnode;
        if (i == startnode) {
            distance[i] = 0;
        } else if (G[startnode][i] > 0) {
            distance[i] = G[startnode][i];
        } else {
            distance[i] = INFINITY;
        }
    }

    visited[startnode] = 1;
    count = 1;

    // Step 2: Main loop to find shortest paths for all vertices
    while (count < n) {
        mindistance = INFINITY;
        nextnode = -1;

        // Choose the unvisited vertex with the minimum distance
        for (i = 1; i <= n; i++) {
            if (distance[i] < mindistance && !visited[i]) {
                mindistance = distance[i];
                nextnode = i;
            }
        }

        // If no more vertices are reachable, terminate
        if (nextnode == -1) break;

        visited[nextnode] = 1;
        count++;

        // Update distance values of the adjacent vertices of the chosen vertex
        for (i = 1; i <= n; i++) {
            if (!visited[i] && G[nextnode][i] > 0) {
                if (mindistance + G[nextnode][i] < distance[i]) {
                    distance[i] = mindistance + G[nextnode][i];
                    pred[i] = nextnode;
                }
            }
        }
    }

    // Step 3: Print the table headers matching required tab alignments
    printf("%4s\t%8s\t%s\n", "Node", "Distance", "Path");

    for (i = 1; i <= n; i++) {
        if (i == startnode) continue; // Skip printing the source node itself

        // If the vertex is unreachable
        if (distance[i] >= INFINITY) {
            printf("%4d\t%8s\t%s\n", i, "INF", "NO PATH");
        } 
        // If the vertex is reachable
        else {
            char distStr[20];
            sprintf(distStr, "%d", distance[i]);
            printf("%4d\t%8s\t", i, distStr);

            // Print the path in reverse using the predecessor array
            int curr = i;
            printf("%d", curr);
            while (curr != startnode) {
                curr = pred[curr];
                printf("<-%d", curr);
            }
            printf("\n");
        }
    }


}
int main() { 
	int s, d, w, i, j;
	printf("Enter the number of vertices : ");
	scanf("%d", &V);
	printf("Enter the number of edges : ");
	scanf("%d", &E);
	for(i = 1 ; i <= V; i++) {
		for(j = 1; j <= V; j++) {
			graph[i][i] = 0;
		}
	}
	for(i = 1; i <= E; i++) {
		printf("Enter source : ");
		scanf("%d", &s);
		printf("Enter destination : ");
		scanf("%d", &d);
		printf("Enter weight : ");
		scanf("%d", &w);
		if(s > V || d > V || s <= 0 || d <= 0) {
			printf("Invalid index. Try again.\n");
			i--;
			continue;
		} else {
			graph[s][d] = w;
		}
	}
	printf("Enter the source :");
	scanf("%d", &s);
	dijkstra(graph, V, s); 
	return 0; 
} 
