#include <stdio.h>

// Helper function to find the maximum of two numbers
int max(int a, int b) {
    return (a > b) ? a : b;
}

// Function to solve the 0/1 Knapsack problem using dynamic programming
int knapsack(int n, int values[], int weights[], int W) {
    // dp[i][w] will store the maximum value using first i items with capacity w
    int dp[n + 1][W + 1];

    // Build the dp table in a bottom-up manner
    for (int i = 0; i <= n; i++) {
        for (int w = 0; w <= W; w++) {
            // Base Case: If there are no items or capacity is 0
            if (i == 0 || w == 0) {
                dp[i][w] = 0;
            }
            // If the weight of the current item is less than or equal to the capacity 'w'
            else if (weights[i - 1] <= w) {
                // We choose the maximum between including the item or excluding it
                dp[i][w] = max(values[i - 1] + dp[i - 1][w - weights[i - 1]], dp[i - 1][w]);
            }
            // If the weight of the current item is more than the capacity 'w', exclude it
            else {
                dp[i][w] = dp[i - 1][w];
            }
        }
    }

    // The last cell contains the maximum value for n items and capacity W
    return dp[n][W];
}

int main() {
    int n, W;

    // Read the number of items
    if (scanf("%d", &n) != 1) return 0;

    int values[n];
    // Read the values of the items
    for (int i = 0; i < n; i++) {
        if (scanf("%d", &values[i]) != 1) return 0;
    }

    int weights[n];
    // Read the weights of the items
    for (int i = 0; i < n; i++) {
        if (scanf("%d", &weights[i]) != 1) return 0;
    }

    // Read the capacity of the knapsack
    if (scanf("%d", &W) != 1) return 0;

    // Calculate and print the maximum value
    printf("%d\n", knapsack(n, values, weights, W));

    return 0;
}
